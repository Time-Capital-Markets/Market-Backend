  "components": {
    "schemas": {
      "Change": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "nullable": true
          },
          "before": {
            "type": "string",
            "nullable": true
          },
          "after": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string",
            "nullable": true
          },
          "from": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "string",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          }
        }
      },
      "CashFlow": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "enum": [
              "PAYMENT",
              "RECEIPT"
            ]
          },
          "amount": {
            "type": "number"
          },
          "ccy": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "fixing": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "type",
          "amount",
          "ccy",
          "date"
        ]
      },
      "Trade": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "product": {
            "type": "string",
            "enum": [
              "FXNDF",
              "Swap",
              "FXOption"
            ]
          },
          "productDef": {
            "type": "string",
            "nullable": true
          },
          "underlying": {
            "type": "string",
            "nullable": true
          },
          "direction": {
            "type": "string",
            "nullable": true
          },
          "cpty": {
            "type": "string"
          },
          "po": {
            "type": "string",
            "nullable": true
          },
          "book": {
            "type": "string"
          },
          "notional": {
            "type": "number"
          },
          "ccy": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "tradeDate": {
            "type": "string",
            "format": "date"
          },
          "fixingDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "settleDate": {
            "type": "string",
            "format": "date"
          },
          "fixingSource": {
            "type": "string",
            "nullable": true
          },
          "settleCcy": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PRICING",
              "PENDING",
              "VERIFIED",
              "CANCELED",
              "EXERCISED",
              "TERMINATED",
              "MATURED"
            ]
          },
          "enteredBy": {
            "type": "string",
            "nullable": true
          },
          "authorizedBy": {
            "type": "string",
            "nullable": true
          },
          "audit": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "sdi": {
            "type": "string",
            "nullable": true
          },
          "settlementMethod": {
            "type": "string",
            "nullable": true
          },
          "cashflows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CashFlow"
            }
          }
        },
        "required": [
          "id",
          "product",
          "status",
          "cpty",
          "book",
          "notional",
          "rate",
          "ccy",
          "settleCcy",
          "tradeDate",
          "settleDate"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "TradePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trade"
            }
          },
          "page": {
            "type": "integer",
            "nullable": true
          },
          "size": {
            "type": "integer",
            "nullable": true
          },
          "hasNext": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    }
  }
